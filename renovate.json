{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":prHourlyLimit2",
    ":prConcurrentLimit10"
  ],
  "timezone": "Asia/Seoul",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["package.json"],
      "groupName": "root deps",
      "commitMessageTopic": "root dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["packages/react-vite/**"],
      "groupName": "react-vite template",
      "commitMessageTopic": "react-vite deps"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["packages/nextjs-app-router/**"],
      "groupName": "nextjs-app-router template",
      "commitMessageTopic": "nextjs-app-router deps"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["packages/nextjs-pages-router/**"],
      "groupName": "nextjs-pages-router template",
      "commitMessageTopic": "nextjs-pages-router deps"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["packages/electron-vite-react/**"],
      "groupName": "electron-vite-react template",
      "commitMessageTopic": "electron-vite-react deps"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["packages/expo-react-native/**"],
      "groupName": "expo-react-native template",
      "commitMessageTopic": "expo-react-native deps",
      "description": "Keep the Expo SDK and its pinned React Native runtime family in one atomic PR. separateMajorMinor:false forces an Expo SDK major bump to travel together with the react-native/reanimated/worklets/screens versions that SDK pins, instead of splitting into a major PR + a non-major PR (which produces an SDK/RN mismatch). After merge, run `npx expo install --check` to align with the SDK's bundledNativeModules.",
      "separateMajorMinor": false,
      "separateMultipleMajor": false
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["packages/expo-webview/**"],
      "groupName": "expo-webview template",
      "commitMessageTopic": "expo-webview deps",
      "description": "See expo-react-native rule: Expo SDK + RN runtime stay in one atomic PR including majors.",
      "separateMajorMinor": false,
      "separateMultipleMajor": false
    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major-update"]
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": false
    },
    {
      "matchPackageNames": ["node"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "prBodyNotes": [
    "Template repo — verify each package still scaffolds correctly after merge."
  ]
}
