{
  "name": "expo-webview-shadcn-boilerplate",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Expo WebView shell that hosts a Next.js (or any web) app with native shadcn-style fallback UI and a typed postMessage bridge",
  "keywords": [
    "expo",
    "react-native",
    "react-native-webview",
    "expo-router",
    "nativewind",
    "tailwindcss",
    "shadcn",
    "boilerplate"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/native": "^7.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.3",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  }
}
