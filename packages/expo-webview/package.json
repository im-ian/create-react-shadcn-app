{
  "name": "expo-webview-shadcn-boilerplate",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Expo WebView shell that hosts a Next.js (or any web) app with native shadcn-style fallback UI and a typed postMessage bridge",
  "keywords": [
    "expo",
    "react-native",
    "react-native-webview",
    "expo-router",
    "nativewind",
    "tailwindcss",
    "shadcn",
    "boilerplate"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/native": "^7.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "~4.4.0",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.9.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3"
  }
}
